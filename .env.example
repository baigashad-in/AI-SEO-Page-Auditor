# Get a key at https://agent.tinyfish.ai (API keys page).
# Search and Fetch are free within daily limits. Browser and Agent use credits.
TINYFISH_API_KEY=

# Optional overrides. Leave empty to use the documented TinyFish hosts.
# Only change these for local testing against the mock server in test-harness/.
TINYFISH_SEARCH_URL=
TINYFISH_FETCH_URL=
TINYFISH_BROWSER_URL=
TINYFISH_AGENT_URL=
